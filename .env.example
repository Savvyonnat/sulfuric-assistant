# Discord credentials — get these from https://discord.com/developers/applications
DISCORD_TOKEN=put_your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id

# Optional: register slash commands to a single guild instantly.
# Leave blank to register globally instead (global commands take up to 1 hour to propagate).
GUILD_ID=your_test_server_id_optional

# Optional: presence activity name, shown as "Playing ..."
ACTIVITY_NAME=Sulfuric Online >w<

# AI chat (OpenAI-compatible chat completions).
# Default provider: Groq. Fill AI_API_KEY with a key from https://console.groq.com
# (free tier). With AI_API_KEY empty, the bot falls back to the free Pollinations
# endpoint, which is slow (about 1 reply / 45 seconds per IP).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=60000
AI_COOLDOWN_MS=5000

# Other providers: set AI_BASE_URL + AI_MODEL (AI_API_KEY required).
#   Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.5-flash
#   DeepSeek:       https://api.deepseek.com                                    deepseek-chat
#   OpenRouter:     https://openrouter.ai/api/v1                              <model-slug>
#   LongCat:        https://api.longcat.chat/openai/v1                         LongCat-2.5

# Owner (your Discord user ID) — used for /proxy.
# Leave blank to use the application owner.
OWNER_ID=

# Bots allowed as /proxy targets (IDs or usernames, comma-separated).
# Leave empty = allow any bot (not recommended).
PROXY_BOTS=

# Set to 1 to log voice connection state changes (debugging music playback).
VOICE_DEBUG=0

# AutoMod: minimum severity score before a message is flagged (1 = any hit, 2 = stricter).
AUTOMOD_MIN_SCORE=1

